# Server Port
PORT=5000

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB connection string:
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/communityDB?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://testuser:testpass@cluster0.abcde.mongodb.net/communityDB?retryWrites=true&w=majority

# Secret key or PIN for admin posting/access
ADMIN_SECRET=admin2026

# Node Environment
NODE_ENV=development
